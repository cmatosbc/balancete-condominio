# Copie para .env e preencha — .env é gitignored (nunca commite segredos)

# Senhas de acesso ao app
ADMIN_PASSWORD=troque-esta-senha
MORADOR_PASSWORD=                  # opcional — login morador genérico (transição)
SECRET_KEY=                        # opcional — vazio gera e persiste em DATA_DIR/.secret_key

# SMTP para envio de códigos por e-mail (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PUBLIC_URL=http://seu-dominio-ou-ip:8080

# Evolution API (WhatsApp) — gere uma chave: openssl rand -hex 16
EVO_KEY=
EVO_DB_PASS=
EVO_INSTANCE=condominio
EVO_URL=http://evolution:8080
